// Pin constraints for rtl/uart_echo.v on Tang Nano 20K.
// Source: Sipeed TangNano-20K-example, uart/src/top.cst (rx 70, tx 69, clk 4).
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "rx" 70;
IO_PORT "rx" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "tx" 69;
IO_PORT "tx" DRIVE=8 IO_TYPE=LVCMOS33;
